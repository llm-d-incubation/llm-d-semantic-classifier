#!/usr/bin/env bash
# Deterministic spec verification. Promotion is COMPUTED from per-test status,
# never asserted by the existence of a Markdown file.
#
#  - expands range notation (U-001..U-005) so no required ID hides inside a range
#  - cross-checks every required ID against tests/TEST_MATRIX.md
#  - derives green/pending per ID by locating a real test function
#  - LOCAL tier  = every unit/local-integration ID for the AC is green
#  - PROMOTION   = every required ID (incl. I/S/P tiers) is green
# Usage: spec-check <spec-id> [--promotion] [--refresh]
set -euo pipefail
cd "$(dirname "$0")/.."
ID="${1:?usage: spec-check <spec-id> [--promotion] [--refresh]}"
MODE="${2:-}"
D="specs/$ID"
test -f "$D/spec.md" || { echo "[spec-check] FAIL: $D/spec.md missing"; exit 1; }
test -f "$D/test-plan.md" || { echo "[spec-check] FAIL: $D/test-plan.md missing"; exit 1; }

python3 - "$D" "$MODE" <<'PY'
import json, os, re, subprocess, sys
d, mode = sys.argv[1], sys.argv[2]
plan = open(f"{d}/test-plan.md").read()
matrix = open("tests/TEST_MATRIX.md").read()

def expand(seg):
    ids = set()
    for m in re.finditer(r'\b([UISPR])-(\d{3})\.\.(?:([UISPR])-)?(\d{3})\b', seg):
        kind, lo, _k, hi = m.groups()
        ids.update(f"{kind}-{n:03d}" for n in range(int(lo), int(hi) + 1))
    ids.update(re.findall(r'\b[UISPR]-\d{3}\b',
               re.sub(r'\b[UISPR]-\d{3}\.\.(?:[UISPR]-)?\d{3}\b', ' ', seg)))
    return ids

rows = {}
for line in plan.splitlines():
    m = re.match(r'\|\s*(AC-\d+)\s*\|(.*)\|', line)
    if m:
        rows[m.group(1)] = sorted(expand(m.group(2)))
if not rows:
    print("[spec-check] FAIL: no AC rows parsed from test-plan.md"); sys.exit(1)

matrix_ids = set(re.findall(r'\b[UISPR]-\d{3}\b', matrix))
ghosts = sorted({i for ids in rows.values() for i in ids} - matrix_ids)
if ghosts:
    print(f"[spec-check] FAIL: required IDs absent from TEST_MATRIX: {ghosts}"); sys.exit(1)

# EXECUTION evidence, not source presence: a test function that exists is not
# a test that passed. hack/test-report writes artifacts/test-results.json from
# real suite runs; spec-check refuses to infer green from grep.
results_path = "artifacts/test-results.json"
if os.path.exists(results_path):
    results = json.load(open(results_path))
    have = {k for k, v in results.items() if v.get("status") == "green"}
    src_evidence = f"execution evidence ({len(results)} IDs executed)"
else:
    have = set()
    src_evidence = "NO EXECUTION EVIDENCE — run ./hack/test-report (all IDs treated as pending)"
print(f"[spec-check] evidence source: {src_evidence}")

status = {ac: {i: ("green" if i in have else "pending") for i in ids} for ac, ids in rows.items()}
json.dump(status, open(f"{d}/test-status.json", "w"), indent=1, sort_keys=True)

req_total = sum(len(v) for v in status.values())
req_green = sum(1 for ac in status for i in status[ac] if status[ac][i] == "green")
print(f"[spec-check] {len(rows)} ACs | {req_total} required IDs (ranges expanded) | {req_green} green, {req_total-req_green} pending")

not_promo = []
for ac in sorted(status):
    ids = status[ac]
    # LOCAL tier is reviewed judgment (which tests belong to the local
    # environment is a spec question) and is recorded by the reviewed
    # LOCAL-GREEN.md artifact. PROMOTION is strictly COMPUTED: every required
    # ID green. Pending IDs are always printed so the gap cannot hide.
    promo_ok = all(v == "green" for v in ids.values())
    local_claimed = os.path.exists(f"{d}/evidence/{ac}/LOCAL-GREEN.md")
    # Per-AC we can only speak about TEST evidence. Version promotion also
    # requires non-test gates (GitHub CI, independent review PASS, exact-SHA
    # homelab validation, maintainer approval) tracked in acceptance.md.
    tier = "TEST-EVIDENCE-GREEN" if promo_ok else ("LOCAL-GREEN" if local_claimed else "open")
    if not promo_ok: not_promo.append(ac)
    pend = [i for i, v in sorted(ids.items()) if v == "pending"]
    print(f"  {ac}: {tier}  ({sum(1 for v in ids.values() if v=='green')}/{len(ids)})" + (f"  pending: {','.join(pend)}" if pend else ""))

if mode == "--promotion":
    fail = False
    if not_promo:
        print(f"[spec-check] PROMOTION FAIL: {len(not_promo)} ACs lack full test evidence: {not_promo}"); fail = True
    # non-test gates: every acceptance.md checkbox must be ticked
    acc = f"{d}/acceptance.md"
    if os.path.exists(acc):
        unchecked = [l.strip() for l in open(acc) if l.strip().startswith("- [ ]")]
        if unchecked:
            print(f"[spec-check] PROMOTION FAIL: {len(unchecked)} non-test gates unmet in acceptance.md (CI / review / homelab / maintainer):")
            for u in unchecked[:6]: print(f"    {u}")
            fail = True
    else:
        print(f"[spec-check] PROMOTION FAIL: {acc} missing (non-test gates unverifiable)"); fail = True
    if fail: sys.exit(1)
print("[spec-check] OK" + (" (promotion satisfied)" if mode == "--promotion" else ""))
PY
