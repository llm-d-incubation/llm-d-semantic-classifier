#!/usr/bin/env bash
# Materialise a classifier artifact into ./artifacts/models/<name>/ in ModelCar
# layout. Weights are NEVER committed (the target is gitignored).
#
# DEFAULT: the prompt-complexity classifier, which is the signal release 0.1
# serves. Every shipped classifier here is an EMBEDDING model ranked against the
# anchors in classifiers/, which is what the 0.1 serving backend implements.
#
# The generic ModernBERT domain/intent classifier is deliberately NOT offered.
# It is a SEQUENCE-CLASSIFICATION model and the 0.1 backend cannot rank against
# it, so fetching it and pointing the server at it produces confident nonsense
# rather than an error. It returns once the sequence-classification runtime
# adapter lands (see docs/known-gaps.md).
#
# Usage:
#   ./hack/fetch-model                            # default: complexity
#   ./hack/fetch-model --classifier sensitivity   # other built-in taxonomies
#   ./hack/fetch-model --list
set -euo pipefail
cd "$(dirname "$0")/.."

CLASSIFIER="complexity"
while [ $# -gt 0 ]; do
  case "$1" in
    --classifier) CLASSIFIER="${2:?--classifier needs a name}"; shift 2;;
    --list)
      echo "available classifiers:"
      echo "  complexity   (DEFAULT) cnuland/llm-d-sc-complexity"
      echo "               4-tier SIMPLE/MEDIUM/COMPLEX/REASONING, anchor-ranked"
      echo "  sensitivity  cnuland/llm-d-sc-sensitivity"
      echo "               5-tier PUBLIC..NEVER_EGRESS, anchor-ranked"
      echo "  cost         cnuland/llm-d-sc-cost"
      echo "               4-tier MINIMAL/LOW/MODERATE/HIGH, anchor-ranked"
      echo "  baseline-minilm  un-finetuned all-MiniLM-L6-v2 (evaluation baseline only)"
      echo ""
      echo "  Generic DOMAIN classification is not yet available: it needs the"
      echo "  sequence-classification runtime adapter. See docs/known-gaps.md."
      exit 0;;
    *) echo "[fetch-model] unknown argument: $1" >&2; exit 2;;
  esac
done

case "$CLASSIFIER" in
  complexity)
    REPO="cnuland/llm-d-sc-complexity"
    REV="c5f55ef419d268ba843c544dc00988d1e9878044"
    TARGET="artifacts/models/complexity"
    FILES=("model.safetensors" "tokenizer.json" "config.json" "modules.json"
           "1_Pooling/config.json")
    ;;
  baseline-minilm)
    REPO="sentence-transformers/all-MiniLM-L6-v2"
    REV="c9745ed1d9f207416be6d2e6f8de32d1f16199bf"
    TARGET="artifacts/models/baseline-minilm"
    FILES=("model.safetensors" "tokenizer.json" "config.json" "modules.json"
           "1_Pooling/config.json")
    ;;
  cost)
    REPO="cnuland/llm-d-sc-cost"
    REV="main"
    TARGET="artifacts/models/cost"
    FILES=("model.safetensors" "tokenizer.json" "config.json" "modules.json"
           "1_Pooling/config.json")
    ;;
  sensitivity)
    REPO="cnuland/llm-d-sc-sensitivity"
    REV="d82ff10d41fcf7d33f90e0597e6621bf1ff94ed4"
    TARGET="artifacts/models/sensitivity"
    FILES=("model.safetensors" "tokenizer.json" "config.json" "modules.json"
           "1_Pooling/config.json")
    ;;
  *)
    echo "[fetch-model] unknown classifier '$CLASSIFIER' (try --list)" >&2; exit 2;;
esac

missing=0
for f in "${FILES[@]}"; do
  [ -s "$TARGET/$f" ] || { echo "[fetch-model] missing or empty: $TARGET/$f"; missing=1; }
done
if [ "$missing" -eq 0 ]; then
  echo "[fetch-model] $CLASSIFIER already present in $TARGET, skipping download"
  exit 0
fi

mkdir -p "$TARGET"
python3 - "$REPO" "$REV" "$TARGET" "${FILES[@]}" <<'PY'
import os, sys
from huggingface_hub import hf_hub_download
repo, rev, target, *files = sys.argv[1:]
for name in files:
    d = os.path.dirname(name)
    if d:
        os.makedirs(os.path.join(target, d), exist_ok=True)
    hf_hub_download(repo_id=repo, revision=rev, filename=name, local_dir=target)
print(f"[fetch-model] downloaded {repo}@{rev[:12]} -> {target}")
PY

for f in "${FILES[@]}"; do
  [ -s "$TARGET/$f" ] || { echo "[fetch-model] FAIL: $TARGET/$f missing or zero-size" >&2; exit 1; }
done
echo "[fetch-model] OK: $CLASSIFIER ($REPO@${REV:0:12}) present in $TARGET"
