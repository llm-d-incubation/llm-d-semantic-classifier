# ModelCar: a classifier artifact as an OCI image, carrying ONLY model files.
#
# Kept separate from the service image on purpose. The model changes on its own
# schedule, is large, and must be independently digest-pinned (I-062). Baking it
# into the service image would couple a classifier revision bump to a service
# rebuild and make the digest ambiguous.
#
# Permissions matter here and are easy to get wrong. Kubernetes assigns an
# arbitrary non-root UID that owns none of these files (I-061), so files need
# o+r AND every directory needs o+x to be traversable. A blanket
# `--chmod=0444` looks correct and is not: it strips o+x from directories, and
# the copy fails with "Permission denied" on any nested path. Modes are set on
# the build context instead (dirs 0555, files 0444) and preserved by COPY.
FROM registry.access.redhat.com/ubi9/ubi-micro
COPY models/ /models/
USER 65534
